<!DOCTYPE html>
<html>
<head>
  <style>
    body { font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; }
    .header { background: #212529; color: #ffc107; padding: 20px; text-align: center; }
    .content { padding: 20px; }
    table { width: 100%; border-collapse: collapse; }
    th { background: #212529; color: white; padding: 8px; text-align: left; }
    td { padding: 8px; border-bottom: 1px solid #ddd; }
    .total { font-weight: bold; font-size: 1.2em; color: green; }
  </style>
</head>
<body>
  <div class="header">
    <h1>Prairie Tech Market</h1>
    <p>Order Confirmation</p>
  </div>
  <div class="content">
    <p>Hi <%= @order.user.name %>,</p>
    <p>Thank you for your order! Here are your order details:</p>
    <p><strong>Order #:</strong> <%= @order.id %></p>
    <p><strong>Date:</strong> <%= @order.order_date.strftime("%B %d, %Y") %></p>
    <p><strong>Province:</strong> <%= @order.province.name %></p>
    <table>
      <thead>
        <tr>
          <th>Product</th>
          <th>Price</th>
          <th>Qty</th>
          <th>Subtotal</th>
        </tr>
      </thead>
      <tbody>
        <% @order_items.each do |item| %>
          <tr>
            <td><%= item.product.name %></td>
            <td><%= number_to_currency(item.price_at_purchase) %></td>
            <td><%= item.quantity %></td>
            <td><%= number_to_currency(item.price_at_purchase * item.quantity) %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr>
          <td colspan="3" style="text-align:right"><strong>Subtotal:</strong></td>
          <td><%= number_to_currency(@subtotal) %></td>
        </tr>
        <tr>
          <td colspan="3" style="text-align:right"><strong>Tax:</strong></td>
          <td><%= number_to_currency(@tax) %></td>
        </tr>
        <tr>
          <td colspan="3" style="text-align:right"><strong>Total:</strong></td>
          <td class="total"><%= number_to_currency(@order.total_amount) %></td>
        </tr>
      </tfoot>
    </table>
    <p>Thank you for shopping with Prairie Tech Market!</p>
    <p>Winnipeg, Manitoba, Canada</p>
  </div>
</body>
</html>
