<div class="container my-4">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><%= link_to "Home", root_path %></li>
      <li class="breadcrumb-item active">My Profile</li>
    </ol>
  </nav>
  <h1 class="mb-4">My Profile</h1>
  <div class="row">
    <div class="col-md-6">
      <div class="card">
        <div class="card-header bg-dark text-white"><h5 class="mb-0">Account Details</h5></div>
        <div class="card-body">
          <p><strong>Name:</strong> <%= current_user.name %></p>
          <p><strong>Email:</strong> <%= current_user.email %></p>
          <p><strong>Address:</strong> <%= current_user.address %></p>
          <p><strong>City:</strong> <%= current_user.city %></p>
          <p><strong>Postal Code:</strong> <%= current_user.postal_code %></p>
          <p><strong>Province:</strong> <%= current_user.province&.name || "Not set" %></p>
          <%= link_to "Edit Profile", edit_user_registration_path, class: "btn btn-warning" %>
        </div>
      </div>
    </div>
  </div>
</div>
